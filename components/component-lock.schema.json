{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunabot.local/schemas/component-lock-v1.json",
  "title": "Sunabot runtime component lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "supportedPlatforms", "components"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "supportedPlatforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^linux/(?:amd64|arm64)$" }
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source", "license", "architectures", "smoke"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "optional": { "type": "boolean" },
        "source": { "type": "string", "format": "uri" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "license": { "type": "string", "minLength": 1 },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^linux/(?:amd64|arm64)$" }
        },
        "smoke": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    }
  }
}
