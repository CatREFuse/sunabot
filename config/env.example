# Runtime workspace. Keep the real value and all data outside Git.
SUNABOT_WORKSPACE=workspace
SUNABOT_HOST=127.0.0.1
SUNABOT_PORT=8787
NAPCAT_ACCOUNT=
NAPCAT_UID=1000
NAPCAT_GID=1000
NAPCAT_WEBUI_PORT=6099

# Outbound HTTP(S) proxy. auto discovers the current WSL default gateway;
# env uses only SUNABOT_PROXY_URL or standard HTTP(S)_PROXY variables.
SUNABOT_PROXY_MODE=auto
SUNABOT_PROXY_URL=
SUNABOT_PROXY_PORTS=7890
SUNABOT_PROXY_PROBE_TIMEOUT_MS=350
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,[::1]

# WebUI security. Configure the public HTTPS origin exactly when tunneling.
SUNABOT_ADMIN_TOKEN=
SUNABOT_ADMIN_ORIGINS=

# Providers and integrations.
OPENAI_API_KEY=
CODEX_ACCESS_TOKEN=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPEN_ARONA_CODEX_AUTH_FILE=workspace/secrets/codex/auth.json
SUNABOT_CODEX_EXECUTABLE=codex
ONEBOT_ACCESS_TOKEN=
TAVILY_API_KEY=
LIBREOFFICE_PATH=
BARK_URL=
SUNABOT_BARK_AGGREGATION_SECONDS=60
SUNABOT_ONEBOT_OFFLINE_GRACE_SECONDS=20
SUNABOT_ONEBOT_HEARTBEAT_STALE_SECONDS=120
SUNABOT_MONITOR_SERVER_EVENTS=true
SUNABOT_MONITOR_ONEBOT_EVENTS=true
SUNABOT_SUPPRESS_QQ_ONLINE_ANNOUNCEMENT=

# Encrypted Baidu Syncdisk snapshot target and the separately stored key file.
SUNABOT_SYNC_DIR=
SUNABOT_SYNC_KEY_FILE=
SUNABOT_RUNTIME_SYNC_KEY_FILE=
SUNABOT_SECRETS_SYNC_KEY_FILE=
