# Runtime workspace. Keep the real value and all data outside Git.
SUNABOT_WORKSPACE=workspace
SUNABOT_MEDIA_TRANSPORT=inline-base64
SUNABOT_MEDIA_MAX_INLINE_BYTES=33554432

# NapCat always runs in its own Docker container. QQ accounts are managed per Agent.
ONEBOT_ACCESS_TOKEN=
WEBUI_TOKEN=

# Outbound HTTP(S) proxy. auto discovers the current WSL default gateway;
# env uses only SUNABOT_PROXY_URL or standard HTTP(S)_PROXY variables.
SUNABOT_PROXY_MODE=auto
SUNABOT_PROXY_URL=
SUNABOT_PROXY_PORTS=7890
SUNABOT_PROXY_PROBE_TIMEOUT_MS=350
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,[::1],core,host.docker.internal

# WebUI security. Configure the public HTTPS origin exactly when tunneling.
SUNABOT_ADMIN_TOKEN=
SUNABOT_ADMIN_ORIGINS=

# Providers and integrations.
OPENAI_API_KEY=
CODEX_ACCESS_TOKEN=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional absolute override. Defaults to the current workspace secrets/codex/auth.json.
OPEN_ARONA_CODEX_AUTH_FILE=
SUNABOT_CODEX_EXECUTABLE=codex
TAVILY_API_KEY=

# MCP OAuth credential vault: exactly 32 random bytes encoded as canonical base64url.
SUNABOT_MCP_CREDENTIAL_VAULT_KEY=

# MCP stdio is disabled until one hardened backend is selected.
# docker requires a custom image reference pinned by sha256 digest with all server executables preinstalled.
# bubblewrap is Linux/WSL only and requires an absolute root-owned 0444 executable manifest.
SUNABOT_MCP_STDIO_BACKEND=disabled
SUNABOT_MCP_STDIO_DOCKER_IMAGE=
SUNABOT_MCP_STDIO_EXECUTABLE_MANIFEST=
SUNABOT_MCP_STDIO_EXECUTABLE_MANIFEST_SHA256=

BARK_URL=
SUNABOT_BARK_AGGREGATION_SECONDS=60
SUNABOT_ONEBOT_OFFLINE_GRACE_SECONDS=20
SUNABOT_ONEBOT_HEARTBEAT_STALE_SECONDS=120
SUNABOT_MONITOR_SERVER_EVENTS=true
SUNABOT_MONITOR_ONEBOT_EVENTS=true
SUNABOT_SUPPRESS_QQ_ONLINE_ANNOUNCEMENT=
