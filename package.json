{
  "name": "sunabot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/main.ts",
    "dev:web": "vite --config apps/admin-web/vite.config.ts --host 127.0.0.1 --port 5173",
    "start": "node dist/apps/api/main.js",
    "build": "npm run build:web && npm run build:api",
    "build:api": "node tooling/quality/clean-api-build.mjs && tsc",
    "build:web": "vite build --config apps/admin-web/vite.config.ts",
    "check": "tsc --noEmit && vue-tsc --project apps/admin-web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual-light --project=visual-dark",
    "architecture": "node tooling/quality/architecture.mjs",
    "smoke:api": "node tooling/quality/smoke-api.mjs",
    "verify": "npm run architecture && npm run check && npm run test && npm run build && npm run test:e2e",
    "workspace:init": "node tooling/workspace/init-workspace.mjs",
    "workspace:migrate": "node tooling/migrations/migrate-workspace-layout.mjs",
    "workspace:sync": "node tooling/workspace/sync-workspace.mjs",
    "workspace:env": "node tooling/workspace/workspace-env.mjs",
    "code:update": "node tooling/dev/update-code.mjs",
    "admin:set-password": "node tooling/admin/admin-credentials.mjs",
    "admin:fuse": "node tooling/admin/admin-fuse.mjs",
    "migrate:sqlite": "npm run build:api && node tooling/migrations/migrate-to-sqlite.mjs",
    "qq:configure": "node tooling/runtime/configure-napcat-client.mjs",
    "qq:up": "node tooling/runtime/qq-compose.mjs up -d --build",
    "qq:start": "node tooling/runtime/qq-compose.mjs up -d",
    "qq:down": "node tooling/runtime/qq-compose.mjs down",
    "qq:logs": "node tooling/runtime/qq-compose.mjs logs -f",
    "runtime:doctor": "node tooling/runtime/doctor.mjs",
    "napcat:up": "npm run qq:up",
    "napcat:logs": "npm run qq:logs",
    "napcat:configure-client": "npm run qq:configure"
  },
  "dependencies": {
    "@fastify/static": "^9.3.0",
    "@napi-rs/canvas": "^1.0.2",
    "chardet": "^2.2.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "file-type": "^22.0.1",
    "iconv-lite": "^0.7.3",
    "lucide-vue-next": "^0.577.0",
    "nanoid": "^5.0.7",
    "officeparser": "^7.2.3",
    "openai": "^4.104.0",
    "pdfjs-dist": "^6.1.200",
    "sharp": "^0.35.3",
    "undici": "^8.7.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "ws": "^8.18.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.7",
    "@types/ws": "^8.5.13",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "happy-dom": "^20.10.6",
    "postcss": "^8.5.1",
    "pptxgenjs": "^4.0.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.0"
  }
}
