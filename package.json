{
  "name": "sunabot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/main.ts",
    "dev:web": "vite --config apps/admin-web/vite.config.ts --host 127.0.0.1 --port 5173",
    "start": "node dist/apps/api/main.js",
    "build": "npm run build:web && npm run build:api",
    "build:api": "node tooling/quality/clean-api-build.mjs && tsc",
    "build:web": "vite build --config apps/admin-web/vite.config.ts",
    "check": "tsc --noEmit && vue-tsc --project apps/admin-web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual-light --project=visual-dark",
    "architecture": "node tooling/quality/architecture.mjs",
    "smoke:api": "node tooling/quality/smoke-api.mjs",
    "smoke:prepare": "node tooling/quality/prepare-runtime-smoke.mjs",
    "smoke:runtime": "node --use-env-proxy --import tsx tooling/quality/runtime-smoke.ts",
    "test:runtime-smoke": "vitest run --config tests/runtime-smoke/vitest.config.ts",
    "verify": "npm run runtime:contract && npm run architecture && npm run backup:gate && npm run check && npm run test && npm run test:runtime-smoke && npm run benchmark:ci && npm run build && npm run test:e2e",
    "benchmark": "npm run benchmark:ci",
    "benchmark:check": "tsc --noEmit --project tooling/benchmarks/tsconfig.json",
    "benchmark:ci": "npm run benchmark:check && node --expose-gc --import tsx tooling/benchmarks/run.ts --profile ci",
    "benchmark:capacity": "npm run benchmark:check && node --expose-gc --import tsx tooling/benchmarks/run.ts --profile capacity",
    "benchmark:full": "npm run benchmark:check && node --expose-gc --import tsx tooling/benchmarks/run.ts --profile full",
    "backup:create": "node tooling/workspace/sqlite-recovery-cli.mjs create",
    "backup:verify": "node tooling/workspace/sqlite-recovery-cli.mjs verify",
    "backup:restore": "node tooling/workspace/sqlite-recovery-cli.mjs restore",
    "backup:prune": "node tooling/workspace/sqlite-recovery-cli.mjs prune",
    "backup:drill": "node tooling/workspace/sqlite-recovery-cli.mjs drill",
    "backup:gate": "vitest run tests/unit/sqlite-recovery-gate.test.ts",
    "workspace:init": "node tooling/workspace/init-workspace.mjs",
    "workspace:migrate": "node tooling/migrations/migrate-workspace-layout.mjs",
    "workspace:sync": "node tooling/workspace/sync-workspace.mjs",
    "workspace:env": "node tooling/workspace/workspace-env.mjs",
    "office:read": "officeparser",
    "code:update": "node tooling/dev/update-code.mjs",
    "admin:set-password": "node tooling/admin/admin-credentials.mjs",
    "admin:fuse": "node tooling/admin/admin-fuse.mjs",
    "migrate:sqlite": "node tooling/migrations/run-built-migration.mjs migrate-to-sqlite.mjs",
    "migrate:multi-agent": "node tooling/migrations/run-built-migration.mjs migrate-single-agent-to-multi-agent.mjs",
    "migrate:memory-perspective": "node tooling/migrations/memory-perspective-v1.mjs",
    "runtime:doctor": "./sunabot.sh doctor",
    "runtime:contract": "node tooling/runtime/validate-contract.mjs",
    "runtime:release": "node tooling/runtime/build-release.mjs",
    "runtime:native": "./sunabot.sh up --core=native",
    "runtime:macos": "node tooling/runtime/macos.mjs",
    "macos:start": "node tooling/runtime/macos.mjs start",
    "macos:doctor": "node tooling/runtime/macos.mjs doctor",
    "runtime:launcher": "node tooling/runtime/launcher.mjs",
    "runtime:up": "./sunabot.sh up",
    "runtime:down": "./sunabot.sh down",
    "runtime:status": "./sunabot.sh status",
    "runtime:logs": "./sunabot.sh logs"
  },
  "dependencies": {
    "@fastify/static": "^9.3.0",
    "@fontsource-variable/doto": "^5.2.10",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@fontsource/space-mono": "^5.2.9",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@napi-rs/canvas": "^1.0.2",
    "boxicons": "^2.1.4",
    "chardet": "^2.2.0",
    "dotenv": "^16.4.7",
    "echarts": "^6.1.0",
    "fastify": "^5.2.1",
    "file-type": "^22.0.1",
    "iconv-lite": "^0.7.3",
    "nanoid": "^5.0.7",
    "officeparser": "^7.2.3",
    "openai": "^4.104.0",
    "pdfjs-dist": "^6.1.200",
    "sharp": "^0.35.3",
    "undici": "^8.7.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "ws": "^8.18.0",
    "yauzl": "^3.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.7",
    "@types/ws": "^8.5.13",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "happy-dom": "^20.10.6",
    "postcss": "^8.5.1",
    "pptxgenjs": "^4.0.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.0"
  }
}
