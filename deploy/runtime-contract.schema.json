{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunabot.local/schemas/runtime-contract-v3.json",
  "title": "Sunabot Native Runtime Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "runtimeId", "releaseVersion", "supportedPlatforms", "nodeVersion",
    "runtimeUsers", "paths", "network", "mediaTransport", "outboundProxy", "startup",
    "health", "capabilities", "resources", "napcat", "native", "componentsLock"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 3 },
    "runtimeId": { "const": "sunabot-qq-runtime" },
    "releaseVersion": { "$ref": "#/$defs/version" },
    "supportedPlatforms": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "items": { "enum": ["linux/amd64", "linux/arm64"] }
    },
    "nodeVersion": { "const": "24.18.0" },
    "runtimeUsers": {
      "type": "object", "additionalProperties": false, "required": ["native", "napcat"],
      "properties": {
        "native": { "$ref": "#/$defs/namedUser" },
        "napcat": { "$ref": "#/$defs/runtimeUser" }
      }
    },
    "paths": {
      "type": "object", "additionalProperties": false,
      "required": ["installPrefix", "workspace", "config", "database", "sessionQueue", "media", "napcatState", "napcatAccounts", "secrets", "logs", "temporary", "cache", "backups"],
      "properties": {
        "installPrefix": { "$ref": "#/$defs/absolutePath" },
        "workspace": { "$ref": "#/$defs/absolutePath" },
        "config": { "$ref": "#/$defs/relativePath" },
        "database": { "$ref": "#/$defs/relativePath" },
        "sessionQueue": { "$ref": "#/$defs/relativePath" },
        "media": { "$ref": "#/$defs/relativePath" },
        "napcatState": { "const": "runtime/napcat" },
        "napcatAccounts": { "const": "runtime/napcat/accounts" },
        "secrets": { "$ref": "#/$defs/relativePath" },
        "logs": { "$ref": "#/$defs/relativePath" },
        "temporary": { "$ref": "#/$defs/relativePath" },
        "cache": { "$ref": "#/$defs/relativePath" },
        "backups": { "$ref": "#/$defs/relativePath" }
      }
    },
    "network": {
      "type": "object",
      "required": ["onebot"],
      "properties": {
        "onebot": {
          "type": "object",
          "required": ["nativeListenerHosts"],
          "properties": {
            "nativeListenerHosts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["macos", "wsl", "linux"],
              "properties": {
                "macos": { "const": "127.0.0.1" },
                "wsl": { "const": "docker-network-gateway-or-loopback" },
                "linux": { "const": "docker-network-gateway" }
              }
            }
          }
        }
      }
    },
    "mediaTransport": { "type": "object" },
    "outboundProxy": { "type": "object" },
    "startup": { "type": "object" },
    "health": { "type": "object" },
    "capabilities": {
      "type": "object",
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "contains": { "const": "webfetch-dynamic-renderer" }
        },
        "optional": {
          "type": "array",
          "not": { "contains": { "const": "webfetch-dynamic-renderer" } }
        }
      }
    },
    "resources": { "type": "object" },
    "napcat": {
      "type": "object", "additionalProperties": false,
      "required": ["managedBy", "composeProject", "composeFile", "service", "network", "image", "digest", "pullPolicy", "labels"],
      "properties": {
        "managedBy": { "const": "docker" },
        "composeProject": { "type": "string", "minLength": 1 },
        "composeFile": { "const": "deploy/napcat/compose.yml" },
        "service": { "const": "napcat" },
        "network": { "type": "object" },
        "image": { "type": "string", "minLength": 1 },
        "digest": { "pattern": "^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "const": "never" },
        "labels": { "type": "object" }
      }
    },
    "native": {
      "type": "object", "additionalProperties": false, "required": ["core", "bubblewrap", "webfetchRenderer"],
      "properties": {
        "core": { "type": "object" },
        "bubblewrap": {
          "type": "object", "additionalProperties": false,
          "required": ["managedBy", "releaseExecutable", "executableEnvironment", "packagedFallback", "verifiedByLauncher", "consumers"],
          "properties": {
            "managedBy": { "const": "launcher" },
            "releaseExecutable": { "const": "runtime/bubblewrap/bwrap" },
            "executableEnvironment": { "const": "SUNABOT_BWRAP_EXECUTABLE" },
            "packagedFallback": { "const": false },
            "verifiedByLauncher": { "const": true },
            "consumers": {
              "type": "array",
              "prefixItems": [
                { "const": "native-bash" },
                { "const": "mcp-stdio" },
                { "const": "skill-script" },
                { "const": "webfetch-renderer" }
              ],
              "items": false,
              "minItems": 4,
              "maxItems": 4
            }
          }
        },
        "webfetchRenderer": {
          "type": "object",
          "required": ["releaseRequired", "bubblewrapRuntime", "namespaceProbeRequired"],
          "properties": {
            "releaseRequired": { "const": true },
            "bubblewrapRuntime": { "const": "bundled-loader-and-libraries" },
            "namespaceProbeRequired": { "const": true }
          }
        }
      }
    },
    "componentsLock": { "const": "components/component.lock.json" }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" },
    "absolutePath": { "type": "string", "pattern": "^/" },
    "relativePath": { "type": "string", "minLength": 1, "not": { "pattern": "^(?:/|.*(?:^|/)\\.\\.(?:/|$))" } },
    "namedUser": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 } }
    },
    "runtimeUser": {
      "type": "object", "additionalProperties": false, "required": ["name", "uid", "gid"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "uid": { "type": "integer", "minimum": 1 },
        "gid": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
