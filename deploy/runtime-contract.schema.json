{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunabot.local/schemas/runtime-contract-v1.json",
  "title": "Sunabot QQ Runtime Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtimeId",
    "releaseVersion",
    "supportedPlatforms",
    "nodeVersion",
    "runtimeUsers",
    "paths",
    "network",
    "outboundProxy",
    "processes",
    "shutdownTimeoutSeconds",
    "health",
    "capabilities",
    "resources",
    "docker",
    "native",
    "componentsLock"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "runtimeId": { "const": "sunabot-qq-runtime" },
    "releaseVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" },
    "supportedPlatforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["linux/amd64", "linux/arm64"] }
    },
    "nodeVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "runtimeUsers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docker", "native"],
      "properties": {
        "docker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "uid", "gid"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "uid": { "type": "integer", "minimum": 1 },
            "gid": { "type": "integer", "minimum": 1 }
          }
        },
        "native": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installPrefix",
        "workspace",
        "config",
        "database",
        "sessionQueue",
        "media",
        "napcatState",
        "napcatConfig",
        "secrets",
        "logs",
        "temporary",
        "cache",
        "backups"
      ],
      "properties": {
        "installPrefix": { "$ref": "#/$defs/absolutePath" },
        "workspace": { "$ref": "#/$defs/absolutePath" },
        "config": { "$ref": "#/$defs/relativePath" },
        "database": { "$ref": "#/$defs/relativePath" },
        "sessionQueue": { "$ref": "#/$defs/relativePath" },
        "media": { "$ref": "#/$defs/relativePath" },
        "napcatState": { "$ref": "#/$defs/relativePath" },
        "napcatConfig": { "const": "runtime/napcat/config-full" },
        "secrets": { "$ref": "#/$defs/relativePath" },
        "logs": { "$ref": "#/$defs/relativePath" },
        "temporary": { "$ref": "#/$defs/relativePath" },
        "cache": { "$ref": "#/$defs/relativePath" },
        "backups": { "$ref": "#/$defs/relativePath" }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "apiPort", "napcatWebuiPort", "onebotReverseWebSocket"],
      "properties": {
        "host": { "const": "127.0.0.1" },
        "apiPort": { "$ref": "#/$defs/port" },
        "napcatWebuiPort": { "$ref": "#/$defs/port" },
        "onebotReverseWebSocket": { "const": "ws://127.0.0.1:8787/onebot/v11/ws" }
      }
    },
    "outboundProxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultMode",
        "supportedModes",
        "explicitUrlEnv",
        "modeEnv",
        "portsEnv",
        "noProxyRequired"
      ],
      "properties": {
        "defaultMode": { "const": "auto" },
        "supportedModes": {
          "type": "array",
          "prefixItems": [
            { "const": "auto" },
            { "const": "env" },
            { "const": "wsl-host" },
            { "const": "off" }
          ],
          "items": false
        },
        "explicitUrlEnv": { "const": "SUNABOT_PROXY_URL" },
        "modeEnv": { "const": "SUNABOT_PROXY_MODE" },
        "portsEnv": { "const": "SUNABOT_PROXY_PORTS" },
        "noProxyRequired": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "contains": { "const": "127.0.0.1" }
        }
      }
    },
    "processes": { "type": "object" },
    "shutdownTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
    "health": { "type": "object" },
    "capabilities": { "type": "object" },
    "resources": { "type": "object" },
    "docker": { "type": "object" },
    "native": { "type": "object" },
    "componentsLock": { "type": "string", "const": "components/component.lock.json" }
  },
  "$defs": {
    "absolutePath": { "type": "string", "pattern": "^/" },
    "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
  }
}
