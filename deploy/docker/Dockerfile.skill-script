ARG SKILL_SCRIPT_BASE_IMAGE=docker.io/library/node:24.18.0-bookworm-slim@sha256:0778d035a13f3f3833b7f2cb750e0df6cbce45583e84fd822f499f0c902a6c74

FROM ${SKILL_SCRIPT_BASE_IMAGE}

RUN groupadd --gid 65531 sunabot-skill \
    && useradd --uid 65531 --gid 65531 --no-create-home --home-dir /workbench --shell /usr/sbin/nologin sunabot-skill \
    && install -d -m 0555 /usr/local/libexec \
    && install -d -o 65531 -g 65531 -m 0700 /workbench \
    && install -d -o 65531 -g 65531 -m 0555 /skills \
    && ln -sf /usr/local/bin/node /usr/bin/node \
    && rm -rf /usr/local/lib/node_modules/npm \
        /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
        /usr/local/bin/pnpm /usr/local/bin/yarn /usr/local/bin/bunx \
        /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/pip /usr/local/bin/pip3

COPY --chmod=0555 skill-script-entrypoint.mjs /usr/local/libexec/sunabot-skill-script-entrypoint

RUN test -x /bin/bash \
    && test -x /usr/bin/node \
    && test -x /usr/local/libexec/sunabot-skill-script-entrypoint \
    && ! command -v npm \
    && ! command -v npx \
    && ! command -v corepack \
    && ! command -v pnpm \
    && ! command -v yarn \
    && ! command -v bunx \
    && ! command -v uv \
    && ! command -v uvx \
    && ! command -v pip \
    && ! command -v pip3

USER 65531:65531
WORKDIR /workbench
ENTRYPOINT ["/usr/local/libexec/sunabot-skill-script-entrypoint"]
