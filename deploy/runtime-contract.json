{
  "$schema": "./runtime-contract.schema.json",
  "schemaVersion": 1,
  "runtimeId": "sunabot-qq-runtime",
  "releaseVersion": "0.1.0",
  "supportedPlatforms": ["linux/amd64"],
  "nodeVersion": "24.18.0",
  "runtimeUsers": {
    "docker": {
      "name": "napcat",
      "uid": 1000,
      "gid": 1000
    },
    "native": {
      "name": "sunabot"
    }
  },
  "paths": {
    "installPrefix": "/opt/sunabot/current",
    "workspace": "/srv/sunabot/workspace",
    "config": "business/config/sunabot.json",
    "database": "business/data/sunabot.sqlite",
    "sessionQueue": "business/data/session-queue.sqlite",
    "media": "business/media/images",
    "napcatState": "runtime/napcat",
    "secrets": "secrets/runtime.env",
    "logs": "runtime/logs",
    "temporary": "runtime/tmp",
    "cache": "cache",
    "backups": "backups"
  },
  "network": {
    "host": "127.0.0.1",
    "apiPort": 8787,
    "napcatWebuiPort": 6099,
    "onebotReverseWebSocket": "ws://127.0.0.1:8787/onebot/v11/ws"
  },
  "outboundProxy": {
    "defaultMode": "auto",
    "supportedModes": ["auto", "env", "wsl-host", "off"],
    "explicitUrlEnv": "SUNABOT_PROXY_URL",
    "modeEnv": "SUNABOT_PROXY_MODE",
    "portsEnv": "SUNABOT_PROXY_PORTS",
    "noProxyRequired": ["localhost", "127.0.0.1", "::1", "[::1]"]
  },
  "processes": {
    "startupOrder": ["sunabot", "napcat"],
    "supervisor": "deploy/docker/supervisor.mjs",
    "restartDelaySeconds": {
      "sunabot": 2,
      "napcat": 10
    }
  },
  "shutdownTimeoutSeconds": 30,
  "health": {
    "livenessPath": "/api/auth/session",
    "livenessCommand": [
      "/usr/local/bin/node",
      "/srv/sunabot/deploy/docker/healthcheck.mjs"
    ],
    "readinessLayers": ["api", "onebot", "qq", "provider"]
  },
  "capabilities": {
    "required": ["admin-web", "onebot-v11", "image-generation", "office-documents"],
    "optional": ["codex-cli", "websearch", "workspace-bash"]
  },
  "resources": {
    "memory": "4g",
    "cpus": 4,
    "pids": 512,
    "sharedMemory": "1g",
    "logMaxSize": "20m",
    "logMaxFiles": 5
  },
  "docker": {
    "image": "sunabot-qq-runtime",
    "composeService": "qq-runtime",
    "workspaceMount": "/srv/sunabot/workspace"
  },
  "native": {
    "apiUnit": "sunabot-api.service",
    "napcatUnit": "sunabot-napcat.service",
    "targetUnit": "sunabot-runtime.target"
  },
  "componentsLock": "components/component.lock.json"
}
