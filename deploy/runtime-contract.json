{
  "$schema": "./runtime-contract.schema.json",
  "schemaVersion": 2,
  "runtimeId": "sunabot-qq-runtime",
  "releaseVersion": "0.2.0",
  "supportedPlatforms": ["linux/amd64", "linux/arm64"],
  "nodeVersion": "24.18.0",
  "runtimeUsers": {
    "docker": {
      "core": {
        "name": "node",
        "uid": 1000,
        "gid": 1000
      },
      "napcat": {
        "name": "napcat",
        "uid": 1000,
        "gid": 1000
      },
      "webfetchRenderer": {
        "name": "node",
        "uid": 1000,
        "gid": 1000
      }
    },
    "native": {
      "name": "sunabot"
    }
  },
  "paths": {
    "installPrefix": "/opt/sunabot/current",
    "workspace": "/srv/sunabot/workspace",
    "config": "business/config/sunabot.json",
    "database": "business/data/sunabot.sqlite",
    "sessionQueue": "business/data/session-queue.sqlite",
    "media": "business/media/images",
    "napcatState": "runtime/napcat",
    "napcatAccounts": "runtime/napcat/accounts",
    "secrets": "secrets/runtime.env",
    "logs": "runtime/logs",
    "temporary": "runtime/tmp",
    "cache": "cache",
    "backups": "backups"
  },
  "network": {
    "admin": {
      "host": "127.0.0.1",
      "containerHost": "0.0.0.0",
      "port": 8787
    },
    "onebot": {
      "path": "/onebot/v11/ws",
      "containerHost": "0.0.0.0",
      "internalPort": 8788,
      "listenerHostEnv": "SUNABOT_ONEBOT_HOST",
      "listenerPortEnv": "SUNABOT_ONEBOT_PORT",
      "advertisedUrlEnv": "SUNABOT_ONEBOT_ADVERTISED_URL",
      "accessTokenRequired": true,
      "nativeListenerHosts": {
        "macos": "127.0.0.1",
        "wsl": "docker-network-gateway",
        "linux": "docker-network-gateway"
      },
      "nativeAdvertisedUrls": {
        "macos": "ws://host.docker.internal:8788/onebot/v11/ws",
        "wsl": "ws://host.docker.internal:8788/onebot/v11/ws",
        "linux": "ws://host.docker.internal:8788/onebot/v11/ws"
      },
      "dockerAdvertisedUrl": "ws://core:8788/onebot/v11/ws"
    },
    "napcatWebui": {
      "host": "127.0.0.1",
      "containerHost": "0.0.0.0",
      "port": 6099
    }
  },
  "mediaTransport": {
    "outbound": {
      "mode": "inline-base64",
      "onebotScheme": "base64://",
      "sharedFilesystem": false
    },
    "inbound": {
      "acceptedReferences": ["base64", "http", "https"],
      "containerLocalPaths": false
    }
  },
  "outboundProxy": {
    "defaultMode": "auto",
    "supportedModes": ["auto", "env", "wsl-host", "off"],
    "explicitUrlEnv": "SUNABOT_PROXY_URL",
    "modeEnv": "SUNABOT_PROXY_MODE",
    "portsEnv": "SUNABOT_PROXY_PORTS",
    "connectTimeoutMs": 60000,
    "headersTimeoutMs": 600000,
    "bodyTimeoutMs": 600000,
    "noProxyRequired": ["localhost", "127.0.0.1", "::1", "[::1]"]
  },
  "startup": {
    "nativeCoreOrder": ["webfetch-renderer-platform", "core-native", "napcat"],
    "dockerCoreOrder": ["webfetch-renderer", "core", "napcat"],
    "shutdownOrder": ["napcat", "core", "webfetch-renderer"],
    "coreReadyTimeoutSeconds": 60,
    "napcatReadyTimeoutSeconds": 120,
    "shutdownTimeoutSeconds": 30
  },
  "health": {
    "livenessPath": "/api/auth/session",
    "readinessLayers": ["api", "onebot", "qq", "provider"],
    "services": {
      "core": {
        "livenessCommand": [
          "/usr/local/bin/node",
          "/srv/sunabot/deploy/docker/healthcheck.mjs"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "startPeriodSeconds": 45,
        "retries": 6
      },
      "napcat": {
        "livenessCommand": [
          "CMD-SHELL",
          "bash -ec 'exec 3<>/dev/tcp/127.0.0.1/6099'"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "startPeriodSeconds": 60,
        "retries": 12
      },
      "webfetchRenderer": {
        "livenessCommand": [
          "/usr/local/bin/node",
          "-e",
          "fetch('http://127.0.0.1:8790/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "startPeriodSeconds": 45,
        "retries": 6
      }
    }
  },
  "capabilities": {
    "required": ["admin-web", "onebot-v11", "image-generation", "office-documents", "workspace-bash", "codex-cli"],
    "optional": ["websearch", "webfetch", "webfetch-dynamic-renderer"],
    "workspaceBash": {
      "service": "core",
      "isolation": "bubblewrap",
      "executable": "/usr/bin/bwrap",
      "dockerSeccompProfile": "deploy/docker/seccomp-bwrap.json",
      "filesystemMode": "host-readonly-workspace-readwrite",
      "subprocessIsolation": "inherited-mount-and-pid-namespaces",
      "capabilitiesDropped": true,
      "failClosed": true
    },
    "codexCli": {
      "service": "core",
      "version": "0.139.0",
      "executable": "/usr/local/bin/codex",
      "authFile": "secrets/codex/auth.json",
      "failClosed": true
    }
  },
  "resources": {
    "core": {
      "memory": "4g",
      "cpus": 4,
      "pids": 512,
      "sharedMemory": "1g"
    },
    "napcat": {
      "memory": "2g",
      "cpus": 2,
      "pids": 512,
      "sharedMemory": "1g"
    },
    "webfetchRenderer": {
      "memory": "1g",
      "cpus": 1.5,
      "pids": 256,
      "sharedMemory": "512m"
    },
    "logging": {
      "maxSize": "20m",
      "maxFiles": 5
    }
  },
  "docker": {
    "composeProject": "sunabot",
    "composeFile": "deploy/docker/compose.yml",
    "network": {
      "name": "sunabot-runtime",
      "nameEnv": "SUNABOT_DOCKER_NETWORK"
    },
    "services": {
      "core": {
        "name": "core",
        "profile": "core-docker",
        "image": "sunabot-core",
        "workspaceMount": "/srv/sunabot/workspace"
      },
      "napcat": {
        "name": "napcat",
        "image": "sunabot-napcat",
        "upstreamImage": "docker.io/mlikiowa/napcat-docker:v4.15.0@sha256:cde89d766604e570517e9ce66304d4222210479d2209ec04e5d58890dea087f7",
        "stateRoot": "runtime/napcat",
        "webuiPort": 6099
      },
      "webfetchRenderer": {
        "name": "webfetch-renderer",
        "image": "sunabot-webfetch-renderer",
        "port": 8790
      }
    },
    "labels": {
      "runtimeId": "io.sunabot.runtime-id",
      "workspaceId": "io.sunabot.workspace-id",
      "component": "io.sunabot.component",
      "ownerId": "io.sunabot.owner-id",
      "invocationId": "io.sunabot.invocation-id",
      "expiresAtMs": "io.sunabot.expires-at-ms"
    }
  },
  "native": {
    "napcatManagedBy": "docker",
    "webfetchRenderer": {
      "managedBy": "platform",
      "host": "127.0.0.1",
      "port": 8790,
      "authentication": "ephemeral-token",
      "browserSandboxRequired": true,
      "deploymentByPlatform": {
        "macos": "docker",
        "wsl": "launcher",
        "linux": "launcher"
      },
      "sandboxByPlatform": {
        "macos": "docker-seccomp",
        "wsl": "bubblewrap",
        "linux": "bubblewrap"
      },
      "tokenDeliveryByPlatform": {
        "macos": "renderer-container-env-core-fd",
        "wsl": "renderer-fd-core-fd",
        "linux": "renderer-fd-core-fd"
      },
      "runtimeDirectories": ["home", "cache", "run"]
    }
  },
  "componentsLock": "components/component.lock.json"
}
