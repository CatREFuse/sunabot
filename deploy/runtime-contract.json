{
  "$schema": "./runtime-contract.schema.json",
  "schemaVersion": 3,
  "runtimeId": "sunabot-qq-runtime",
  "releaseVersion": "0.3.0",
  "supportedPlatforms": ["linux/amd64", "linux/arm64"],
  "nodeVersion": "24.18.0",
  "runtimeUsers": {
    "native": { "name": "sunabot" },
    "napcat": { "name": "napcat", "uid": 1000, "gid": 1000 }
  },
  "paths": {
    "installPrefix": "/opt/sunabot/current",
    "workspace": "/srv/sunabot/workspace",
    "config": "business/config/sunabot.json",
    "database": "business/data/sunabot.sqlite",
    "sessionQueue": "business/data/session-queue.sqlite",
    "media": "business/media/images",
    "napcatState": "runtime/napcat",
    "napcatAccounts": "runtime/napcat/accounts",
    "secrets": "secrets/runtime.env",
    "logs": "runtime/logs",
    "temporary": "runtime/tmp",
    "cache": "cache",
    "backups": "backups"
  },
  "network": {
    "admin": { "host": "127.0.0.1", "port": 8787 },
    "onebot": {
      "path": "/onebot/v11/ws",
      "internalPort": 8788,
      "listenerHostEnv": "SUNABOT_ONEBOT_HOST",
      "listenerPortEnv": "SUNABOT_ONEBOT_PORT",
      "advertisedUrlEnv": "SUNABOT_ONEBOT_ADVERTISED_URL",
      "accessTokenRequired": true,
      "nativeListenerHosts": {
        "macos": "127.0.0.1",
        "wsl": "docker-network-gateway-or-loopback",
        "linux": "docker-network-gateway"
      },
      "nativeAdvertisedUrls": {
        "macos": "ws://host.docker.internal:8788/onebot/v11/ws",
        "wsl": "ws://host.docker.internal:8788/onebot/v11/ws",
        "linux": "ws://host.docker.internal:8788/onebot/v11/ws"
      }
    },
    "napcatWebui": { "host": "127.0.0.1", "port": 6099 }
  },
  "mediaTransport": {
    "outbound": {
      "mode": "inline-base64",
      "onebotScheme": "base64://",
      "sharedFilesystem": false
    },
    "inbound": {
      "acceptedReferences": ["base64", "http", "https"],
      "containerLocalPaths": false
    }
  },
  "outboundProxy": {
    "defaultMode": "auto",
    "supportedModes": ["auto", "env", "wsl-host", "off"],
    "explicitUrlEnv": "SUNABOT_PROXY_URL",
    "modeEnv": "SUNABOT_PROXY_MODE",
    "portsEnv": "SUNABOT_PROXY_PORTS",
    "connectTimeoutMs": 60000,
    "headersTimeoutMs": 600000,
    "bodyTimeoutMs": 600000,
    "noProxyRequired": ["localhost", "127.0.0.1", "::1", "[::1]"]
  },
  "startup": {
    "order": ["webfetch-renderer", "core-native", "napcat"],
    "shutdownOrder": ["napcat", "core-native", "webfetch-renderer"],
    "coreReadyTimeoutSeconds": 60,
    "napcatReadyTimeoutSeconds": 120,
    "shutdownTimeoutSeconds": 30
  },
  "health": {
    "livenessPath": "/api/auth/session",
    "readinessLayers": ["api", "onebot", "qq", "provider"],
    "services": {
      "onebot": { "path": "/healthz" },
      "napcat": {
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "startPeriodSeconds": 60,
        "retries": 12
      },
      "webfetchRenderer": {
        "path": "/healthz",
        "engine": "lightpanda",
        "port": 8790
      }
    }
  },
  "capabilities": {
    "required": ["admin-web", "onebot-v11", "image-generation", "office-documents", "workspace-bash", "codex-cli", "webfetch", "webfetch-dynamic-renderer"],
    "optional": ["websearch"],
    "workspaceBash": {
      "managedBy": "native",
      "linuxIsolation": "bubblewrap-prlimit",
      "macosPolicy": "approved-admin-host-only",
      "dockerFallback": false,
      "failClosed": true
    },
    "codexCli": {
      "managedBy": "native",
      "version": "0.139.0",
      "executable": "node_modules/@openai/codex/bin/codex.js",
      "authFile": "secrets/codex/auth.json",
      "failClosed": true
    },
    "webfetch": {
      "staticEngine": "node-defuddle",
      "dynamicEngine": "lightpanda",
      "dynamicExecutable": "runtime/lightpanda/lightpanda",
      "chromium": false,
      "telemetry": false
    },
    "mcp": { "managedBy": "native" },
    "skillScript": { "managedBy": "native" }
  },
  "resources": {
    "core": { "memory": "4g", "cpus": 4, "pids": 512 },
    "napcat": { "memory": "2g", "cpus": 2, "pids": 512, "sharedMemory": "1g" },
    "webfetchRenderer": { "memory": "1g", "cpus": 1.5, "pids": 256 },
    "logging": { "maxSize": "20m", "maxFiles": 5 }
  },
  "napcat": {
    "managedBy": "docker",
    "composeProject": "sunabot-napcat",
    "composeFile": "deploy/napcat/compose.yml",
    "service": "napcat",
    "network": { "name": "sunabot-napcat", "nameEnv": "SUNABOT_NAPCAT_NETWORK" },
    "image": "docker.io/mlikiowa/napcat-docker:v4.15.0",
    "digest": "sha256:cde89d766604e570517e9ce66304d4222210479d2209ec04e5d58890dea087f7",
    "pullPolicy": "never",
    "labels": {
      "runtimeId": "io.sunabot.runtime-id",
      "workspaceId": "io.sunabot.workspace-id",
      "component": "io.sunabot.component",
      "accountId": "io.sunabot.account-id"
    }
  },
  "native": {
    "core": { "managedBy": "launcher" },
    "bubblewrap": {
      "managedBy": "launcher",
      "releaseExecutable": "runtime/bubblewrap/bwrap",
      "executableEnvironment": "SUNABOT_BWRAP_EXECUTABLE",
      "packagedFallback": false,
      "verifiedByLauncher": true,
      "consumers": ["native-bash", "mcp-stdio", "skill-script", "webfetch-renderer"]
    },
    "webfetchRenderer": {
      "managedBy": "launcher",
      "engine": "lightpanda",
      "host": "127.0.0.1",
      "port": 8790,
      "authentication": "ephemeral-token",
      "deploymentByPlatform": { "macos": "unavailable", "wsl": "launcher", "linux": "launcher" },
      "sandboxByPlatform": { "macos": "unavailable", "wsl": "bubblewrap", "linux": "bubblewrap" },
      "releaseRequired": true,
      "bubblewrapRuntime": "bundled-loader-and-libraries",
      "namespaceProbeRequired": true,
      "tokenDelivery": "renderer-fd-core-fd",
      "runtimeDirectories": ["home", "cache", "run"]
    }
  },
  "componentsLock": "components/component.lock.json"
}
