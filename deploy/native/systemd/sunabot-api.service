[Unit]
Description=Sunabot API and WebUI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sunabot
Group=sunabot
WorkingDirectory=/opt/sunabot/current
Environment=NODE_ENV=production
Environment=SUNABOT_RELEASE_ROOT=/opt/sunabot/current
Environment=SUNABOT_WORKSPACE=/srv/sunabot/workspace
EnvironmentFile=/srv/sunabot/workspace/secrets/runtime.env
ExecStartPre=/usr/bin/node /opt/sunabot/current/tooling/runtime/doctor.mjs --production --expect-free
ExecStart=/opt/sunabot/current/deploy/native/bin/start-sunabot.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
LimitNOFILE=8192
TasksMax=256
MemoryMax=3G
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/sunabot/workspace
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=sunabot-runtime.target
