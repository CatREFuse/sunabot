[Unit]
Description=Sunabot NapCat QQ adapter
After=network-online.target sunabot-api.service
Wants=network-online.target
Requires=sunabot-api.service

[Service]
Type=simple
User=sunabot
Group=sunabot
WorkingDirectory=/opt/sunabot/current
Environment=SUNABOT_WORKSPACE=/srv/sunabot/workspace
Environment=SUNABOT_NAPCAT_COMPONENT_ROOT=/opt/sunabot/components/napcat/current
EnvironmentFile=/srv/sunabot/workspace/secrets/runtime.env
ExecStart=/opt/sunabot/current/deploy/native/bin/start-napcat.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
LimitNOFILE=8192
TasksMax=384
MemoryMax=3G
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/sunabot/workspace
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=sunabot-runtime.target
